// ------------------------------------------------------------------
// CONFIGURAÇÃO PERSONALIZADA - NIRI + NOCTALIA
// ------------------------------------------------------------------

// Monitor Secundário (Fica em cima, portanto y = 0)
output "DP-1" {
    mode "1920x1080@144.000" // Ajuste para a sua resolução/HZ real
    position x=0 y=0
}

// Tela do Notebook (Fica embaixo, logo o Y é a altura do monitor de cima)
output "eDP-1" {
    mode "2880x1800@120.000" // Ajuste para a sua resolução/HZ real
    position x=0 y=1080
}

// 1. Variáveis de Ambiente Globais
environment {
    BROWSER "flatpak run app.zen_browser.zen"
    TERMINAL "ghostty"
    EDITOR "flatpak run com.vscodium.codium"
}

// 2. Inicialização Automática de Serviços

//Abre programas X11
spawn-at-startup "xwayland-satellite"

// Inicializações do sistema
spawn-at-startup "swww-daemon"
spawn-at-startup "quickshell" "--path" "/etc/quickshell/topbar/pill"
spawn-at-startup "quickshell" "--path" "/etc/quickshell/topbar/launcher"

// Agente Bluetooth Invisível (Headless)
spawn-at-startup "bt-agent" "-c" "NoInputNoOutput"

// Agente Polkit
spawn-at-startup "/usr/libexec/kf6/polkit-kde-authentication-agent-1"

// Serviço de Histórico do Clipboard (Alimenta a Pill do Quickshell)
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"

// 3. Configurações de Entrada (Mouse, Teclado br e Touchpad)
input {
    mouse {
        accel-speed -0.5
        scroll-method "on-button-down"
        scroll-button 274
    }

    // Foco Acompanha o Mouse
    focus-follows-mouse max-scroll-amount="10%"

    // Layout Teclado Americano Internacional
    keyboard {
        xkb {
            layout "br"
        }
    }

    touchpad {
        tap
        natural-scroll
    }
}

// 4. Layout e Espaçamentos
layout {
    gaps 4
    center-focused-column "never"
    default-column-width { proportion 0.5; }

    // Bordas de Foco
    focus-ring {
        width 4
        active-color "rgba(34, 126, 142, 0.75)"        
        inactive-color "#798bb2ff"
    }
}

// --- REGRAS DE JANELAS E OPACIDADE ---
// Janelas em segundo plano (inativas) ficam com 88% de opacidade para o blur aparecer
window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
    opacity 0.88
}

// Janela em foco (ativa) fica 100% opaca para melhor leitura
window-rule {
    match is-active=true
    opacity 1.0
}

// --- REGRAS DE CAMADAS (Barra Superior e Widgets) ---
layer-rule {
    background-effect {
        blur false
        xray false
    }
}

// --- CONFIGURAÇÃO DO MOTOR DE BLUR ---
blur {
    passes 4
    offset 4.0
    noise 0.02
    saturation 1.1
}

// 7. Atalhos de Teclado (Binds)
binds {
    // --- Lançamento de Aplicações ---
    Mod+Return { spawn "ghostty"; }
    Mod+Z      { spawn "flatpak" "run" "app.zen_browser.zen"; }
    Mod+C      { spawn "flatpak" "run" "com.vscodium.codium"; }
    Mod+E      { spawn "nautilus"; }

    // --- Alternar Janela Flutuante ---
    Mod+T      { toggle-window-floating; }

    // --- Integração Pill(IPC) ---
    Mod+Space { spawn "sh" "-c" "quickshell --path /etc/quickshell/topbar/launcher ipc call launcher toggle $(niri msg -j focused-output | jq -r .name)"; }
    Mod+W     { spawn "sh" "-c" "quickshell --path /etc/quickshell/topbar/pill ipc call pill wallpaper $(niri msg -j focused-output | jq -r .name)"; }
    Mod+M { spawn "quickshell" "--path" "/etc/quickshell/topbar/pill" "ipc" "call" "pill" "settings" ""; }
    Mod+V { spawn "sh" "-c" "quickshell --path /etc/quickshell/topbar/pill ipc call pill clipboard $(niri msg -j focused-output | jq -r .name)"; }

    // --- Gerenciamento de Janelas ---
    Mod+Q       { close-window; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // --- Navegação estilo Vim (H, J, K, L) ---
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-workspace-up; }
    Mod+J { focus-workspace-down; }

    // --- Teclas de Mídia e Hardware do Notebook ---
    // Controle de Áudio
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+" "-l" "1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-source-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    // Brilho da Tela   
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // Brilho do Teclado Retroiluminado
    XF86KbdBrightnessUp    { spawn "noctalia" "msg" "kbd-backlight-up"; }
    XF86KbdBrightnessDown  { spawn "noctalia" "msg" "kbd-backlight-down"; }

    // --- Bloqueio de Tela & Captura ---
    Mod+Alt+L { spawn "sh" "-c" "quickshell -b qylock -c ~/.config/quickshell/qylock/main.qml"; }

    // Print Screen Nativo do Niri 
    Print { screenshot; }
    Alt+Print { screenshot-window; }
    Ctrl+Print { screenshot-screen; }
}
